# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081

# Only needed if the backend above is genuinely local (localhost/127.0.0.1/
# ::1) and you want to preview locally-uploaded poster/backdrop images
# (e.g. via /admin/movies) — Next.js 16 blocks image optimization for any
# upstream host that resolves to a private/loopback IP by default (see
# next.config.ts). Leave unset otherwise, including in any real deployment:
# missing/any-other-value always keeps the safer default off.
# NEXT_ALLOW_LOCAL_IMAGE_OPTIMIZATION=true
