# Copy this file to .env and adjust if needed. docker-compose and the
# `local` Spring profile share these values.
POSTGRES_DB=cineverse
POSTGRES_USER=cineverse
POSTGRES_PASSWORD=cineverse
POSTGRES_PORT=5432

REDIS_PORT=6379

# Phase 6 (payments) — read directly by the backend process (`mvn
# spring-boot:run`), not by docker-compose. No dev-only fallback exists for
# these (unlike the JWT secrets, which aren't even listed here) — a
# checkout attempt with these unset fails loudly against Stripe's API
# instead of silently doing something wrong.
#
# Get both from the Stripe Dashboard in TEST MODE (dashboard.stripe.com,
# free account, no real business/banking details required for test mode):
# - STRIPE_SECRET_KEY: Developers -> API keys -> "Secret key" (starts with sk_test_)
# - STRIPE_WEBHOOK_SECRET: only needed if you're forwarding webhooks locally
#   via the Stripe CLI, which prints its own whsec_... value when you run
#   `stripe listen` — see docs/DEVELOPMENT.md for the full local setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin movie creation's "search TMDB" convenience (/admin/movies/new) — get
# a free v3 API key from themoviedb.org (Settings -> API). Unlike the Stripe
# keys above, this one has a dev-only fallback (blank) baked into
# application.yml: a missing key only disables the search prefill, admins
# can still create movies by hand, so there's nothing to fail loudly about.
TMDB_API_KEY=
